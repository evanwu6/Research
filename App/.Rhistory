geom_hline(yintercept = 0, color = "black", size = 0.5) +
geom_point(aes(color = pitch_name), alpha = 0.4) +
facet_wrap(~ facet_label) +
labs(
title = "Pitch Movement of Pitch Arsenal",
y = "Induced Vertical Break",
x = "Horizontal Break",
color = "Pitch Type"
) +
theme_classic()
