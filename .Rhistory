is_sylvie = as.factor(is_sylvie)) %>%
mutate(count = ifelse(text != "", 1, 0),
week = week(date),
month = month(date),
year = year(date)) %>%
mutate(week = ifelse(year == 2024, week - 33, week + 19)) %>%
group_by(week, is_sylvie) %>%
summarise(counts = n(), .groups = "drop") %>%
group_by(week) %>%
mutate(total = sum(counts),
proportion = ifelse(is_sylvie == "1", counts / total, NA)) %>%
ggplot(aes(x = week, y = counts, fill = is_sylvie)) +
scale_fill_manual(values = c("gray85", "red")) +
geom_bar(stat = "identity", show.legend = FALSE, color = "white") +
geom_text(aes(label = ifelse(is_sylvie == "1", paste0(round(proportion * 100), "%"), "")),
vjust = -25, color = "red", size = 2, family = "Times") +
theme_dark()+
theme(text = element_text(family = "Times"),
plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5)) +
labs(title = "Proportion of GroupMe Texts by Week",
subtitle = "Red indicates Sylvie",
x = "Week",
y = "")
View(data)
View(data2)
View(text_prop)
max(data2$date) - min(data2$date)
