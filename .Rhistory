# Libraries ####
library(tidyverse)
library(readxl)
library(ggforce)
library(knitr)
library(forcats)
# Barrel Function
is.barrel <- function(LA, EV){
upper <- 1.11*EV - 78.89
lower <- -EV + 124
outcome <- (LA >= lower) & (LA <= upper) & (EV >= 98) & (LA >= 8) & (LA <= 50)
outcome <- replace_na(outcome, FALSE)
outcome
}
# Overall Numbers for Pitchers
