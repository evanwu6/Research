"Fly" = sum(TaggedHitType == "FlyBall", na.rm = TRUE),
"Line" = sum(TaggedHitType == "LineDrive", na.rm = TRUE),
"Pop" = sum(TaggedHitType == "PopUp", na.rm = TRUE)) %>%
rbind(total_h) %>%
tableGrob(rows = NULL, theme = custom_theme)
